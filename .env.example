# Database: postgres://user:pass@host:5432/db in Docker; pglite:./.data/pglite for local development.
DATABASE_URL=pglite:./.data/pglite
# Docker Postgres (docker-compose.yml)
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp
# Public address of the app (cookies are Secure there)
APP_URL=https://bot.kleinbot.online
# Cloudflare tunnel (same token as the old bot)
CLOUDFLARE_TUNNEL_TOKEN=
# Telegram bot (same line as in the old bot's .env); the webhook is registered at start
BOT_TOKEN=
# Optional: own webhook secret (otherwise derived from BOT_TOKEN)
TELEGRAM_WEBHOOK_SECRET=
# Assistant (same lines as in the old bot's .env); empty key = assistant hidden
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Or Google Gemini: its key here (and AI_PROVIDER=gemini when both keys are set).
# AI_MODEL is then taken only when it names a Gemini model, otherwise gemini-3.8-flash.
GEMINI_API_KEY=
# When that model is busy or over its limit, these are tried in turn ("none": no other).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
AI_PROVIDER=
# Questions per person and day
AI_DAILY_LIMIT=100
# Assistant questions per day across the whole server (all companies together)
AI_SERVER_DAILY_LIMIT=500
# Sign-up: invite (default; only by invitation, the first account on an empty server excepted) or open
REGISTRATION=invite
# E-mail (invitations, password links, invoices). Empty SMTP_HOST = no e-mail, links are shown to copy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Subscriptions (optional). Without STRIPE_SECRET_KEY every company has every feature.
# Webhook endpoint in Stripe: https://<your domain>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Key for the secrets companies store (their own Stripe keys for their online stores).
# Empty: the server makes one once and keeps it in UPLOAD_DIR/.keys — never in the database.
# Losing it means those keys have to be entered again.
APP_SECRET_KEY=

# Tracking of DHL parcels (optional): a key from developer.dhl.com (Shipment Tracking - Unified).
DHL_API_KEY=
