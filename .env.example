# Database: postgres://user:pass@host:5432/db in Docker; pglite:./.data/pglite for local development.
DATABASE_URL=pglite:./.data/pglite
# Docker Postgres (docker-compose.yml)
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp
# Public address of the app (cookies are Secure there)
APP_URL=https://bot.kleinbot.online
# Cloudflare tunnel (same token as the old bot)
CLOUDFLARE_TUNNEL_TOKEN=
# Telegram bot (same line as in the old bot's .env); the webhook is registered at start
BOT_TOKEN=
# Optional: own webhook secret (otherwise derived from BOT_TOKEN)
TELEGRAM_WEBHOOK_SECRET=
# Assistant (same lines as in the old bot's .env); empty key = assistant hidden
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Questions per person and day
AI_DAILY_LIMIT=100
# Assistant questions per day across the whole server (all companies together)
AI_SERVER_DAILY_LIMIT=500
# Sign-up: invite (default; only by invitation, the first account on an empty server excepted) or open
REGISTRATION=invite
# E-mail (invitations, password links, invoices). Empty SMTP_HOST = no e-mail, links are shown to copy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
